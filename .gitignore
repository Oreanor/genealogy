# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Local FamilySearch browser profile (for browser automation)
playwright-fs-profile/

# Book sources and FamilySearch / Podvig exports stay local (heavy; Vercel serverless < 250 MB)
/docs/

# Local Lighthouse / PageSpeed measurement artifacts
/perf/

# misc
.DS_Store
.cursor/
*.pem
*.bak
.tmp-lj-*


# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Home-server deploy build
/.next-deploy/
